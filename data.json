  "full": [
   {
    "kz": "Жануарларды тамақтандыруға, оларға тамақ пен заттар лақтыруға тыйым салынады.",
    "ru": "Запрещается кормить животных, бросать в вольеры еду и предметы.",
    "en": "Do not feed the animals or throw food or objects into enclosures."
   },
   {
    "kz": "Жануарларды мазалауға, қорқытуға, торлар мен әйнекті қағуға тыйым салынады.",
    "ru": "Запрещается дразнить и пугать животных, стучать по вольерам и стёклам.",
    "en": "Do not tease or frighten the animals or knock on enclosures and glass."
   },
   {
    "kz": "Қоршаулардан асуға, тор арқылы қол-аяқ созуға, балаларды қоршауларға отырғызуға тыйым салынады.",
    "ru": "Запрещается перелезать через ограждения, просовывать руки сквозь сетки, сажать детей на барьеры.",
    "en": "Do not climb barriers, reach through fences or sit children on barriers."
   },
   {
    "kz": "Балаларды қараусыз қалдыруға болмайды. Балалар үшін ата-аналары немесе оларды алмастыратын адамдар жауап береді.",
    "ru": "Нельзя оставлять детей без присмотра. За детей отвечают родители или сопровождающие.",
    "en": "Do not leave children unattended. Parents or accompanying adults are responsible for them."
   },
   {
    "kz": "Үй жануарларымен кіруге тыйым салынады.",
    "ru": "Вход с домашними животными запрещён.",
    "en": "Pets are not allowed."
   },
   {
    "kz": "Темекі шегуге, алкоголь ішуге және мас күйде келуге тыйым салынады.",
    "ru": "Запрещается курить, распивать алкоголь и находиться в нетрезвом виде.",
    "en": "Smoking, drinking alcohol and being intoxicated are not allowed."
   },
   {
    "kz": "Жануарларды жарқылмен суретке түсіруге тыйым салынады.",
    "ru": "Запрещается фотографировать животных со вспышкой.",
    "en": "Flash photography of animals is not allowed."
   },
   {
    "kz": "Көгалмен жүруге, өсімдіктерді жұлуға, бұтақтарды сындыруға тыйым салынады.",
    "ru": "Запрещается ходить по газонам, рвать растения и ломать ветки.",
    "en": "Do not walk on lawns, pick plants or break branches."
   },
   {
    "kz": "Аумақта скейтборд, ролик, велосипед, самокат пен электрокөлікпен жүруге тыйым салынады. Кішкентай балаларға арналған арбалар мен көлік құралдарына рұқсат етіледі.",
    "ru": "Запрещается передвигаться на скейтбордах, роликах, велосипедах, самокатах и электротранспорте. Коляски и детские средства передвижения для малышей разрешены.",
    "en": "Skateboards, roller skates, bicycles, scooters and e-vehicles are not allowed. Strollers and small children's ride-ons are allowed."
   },
   {
    "kz": "Шуламаңыз, жүгірмеңіз, қатты музыка қоспаңыз, пиротехника қолданбаңыз.",
    "ru": "Не шумите, не бегайте, не включайте громкую музыку, не используйте пиротехнику.",
    "en": "Do not shout, run, play loud music or use fireworks."
